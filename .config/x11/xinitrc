#!/bin/sh
# Started by startx (see "Starting dwm on login" in the README). Starts what
# dwm doesn't start itself, then dwm.

# dwmblocks runs the bar blocks in ~/.local/bin/statusbar
export PATH="$HOME/.local/bin:$HOME/.local/bin/statusbar:$PATH"
# nmtui and other newt programs in gruvbox colors
export NEWT_COLORS='root=,black window=,black border=yellow,black title=yellow,black
roottext=white,black textbox=white,black label=white,black helpline=white,black
button=black,yellow actbutton=black,yellow compactbutton=white,black
listbox=white,black actlistbox=black,yellow sellistbox=yellow,black actsellistbox=black,yellow
entry=white,black disentry=gray,black checkbox=white,black actcheckbox=black,yellow
emptyscale=,black fullscale=,yellow'

xrdb -merge ~/.config/x11/xresources
xsetroot -cursor_name left_ptr
# Sets the wallpaper that ~/.local/share/bg links to
setbg

# GTK 4 apps read their theme from gsettings; GTK 3 apps read
# ~/.config/gtk-3.0/settings.ini
gnome_schema=org.gnome.desktop.interface
gsettings set $gnome_schema color-scheme 'prefer-dark'
gsettings set $gnome_schema gtk-theme 'Adwaita-dark'
gsettings set $gnome_schema icon-theme 'Adwaita'
gsettings set $gnome_schema cursor-theme 'Adwaita'
gsettings set $gnome_schema cursor-size 24

# --systemd only where systemd runs; Artix with dinit has none
dbus-update-activation-environment $([ -d /run/systemd/system ] && echo --systemd) DISPLAY XAUTHORITY

# Lock after 5 minutes without input, turn the displays off after 10, and
# lock before the computer goes to sleep
xset s 300 300
xset dpms 600 600 600
xss-lock -- slock &

# The compositor, so st's background can be transparent
xcompmgr &
dunst &
dwmblocks &
# Network and Bluetooth icons in the system tray
nm-applet &
blueman-applet &
# Hides the mouse cursor when it hasn't moved for a moment
unclutter &
# Fedora keeps the agent in /usr/libexec
if command -v lxqt-policykit-agent > /dev/null; then
    lxqt-policykit-agent &
else
    /usr/libexec/lxqt-policykit-agent &
fi

# sysact ends dwm with SIGTERM for "leave dwm" and SIGHUP for "renew dwm".
# Start dwm again after SIGHUP (exit status 128 + 1), so renewing loads a new
# build and keeps the open windows. Anything else ends the X session.
while :; do
    dwm
    [ $? -eq 129 ] || break
done
