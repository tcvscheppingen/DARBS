# Restart dunst after changing this file: killall dunst; dunst &

[global]
    font = JetBrainsMono Nerd Font 10
    origin = top-right
    offset = (10, 10)
    width = 350
    gap_size = 10
    padding = 10
    horizontal_padding = 10
    frame_width = 3
    corner_radius = 0
    separator_height = 0
    progress_bar_frame_width = 0
    highlight = "#504945"
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#282828"
    foreground = "#928374"
    frame_color = "#504945"
    timeout = 5

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#d79921"
    timeout = 5

[urgency_critical]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#fb4934"
    timeout = 0
