# Restart dunst after changing this file: killall dunst; dunst &

[global]
    font = JetBrainsMono Nerd Font 10
    origin = top-right
    offset = (10, 10)
    width = 350
    gap_size = 10
    padding = 10
    horizontal_padding = 10
    frame_width = 3
    corner_radius = 0
    separator_height = 0
    progress_bar_frame_width = 0
    highlight = "#3d7ab8"
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#151515"
    foreground = "#8a8a8a"
    frame_color = "#3a3a3a"
    timeout = 5

[urgency_normal]
    background = "#151515"
    foreground = "#c6c6c6"
    frame_color = "#3d7ab8"
    timeout = 5

[urgency_critical]
    background = "#151515"
    foreground = "#c6c6c6"
    frame_color = "#c25d5d"
    timeout = 0
