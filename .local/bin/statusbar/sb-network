#!/bin/sh
# Network block for dwmblocks: the connection that has the default route.
# Click to set up connections with nmtui.

case $BLOCK_BUTTON in
    1) setsid -f "${TERMINAL:-st}" -e nmtui ;;
esac

dev=$(ip route show default 2> /dev/null | awk '{ print $5; exit }')

if [ -z "$dev" ]; then
    echo 'wifi down'
elif [ -d "/sys/class/net/$dev/wireless" ]; then
    ssid=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2> /dev/null)
    # NetworkManager's signal strength of the network in use. The kernel's link
    # quality in /proc/net/wireless reads 0 with some drivers and kernels.
    signal=$(nmcli -t -f IN-USE,SIGNAL device wifi list --rescan no ifname "$dev" 2> /dev/null \
        | awk -F: '$1 == "*" { print $2; exit }')
    echo "wifi ${ssid:-$dev}${signal:+ $signal%}"
else
    echo "eth $dev"
fi
