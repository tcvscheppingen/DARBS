#!/bin/sh
# Volume block for slstatus, from WirePlumber's default output

volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2> /dev/null) || exit

case "$volume" in
    *MUTED*) echo ' | vol mute'; exit ;;
esac

# "Volume: 0.45" -> 45
percent=$(echo "$volume" | awk '{ printf "%d", $2 * 100 + 0.5 }')
if wpctl inspect @DEFAULT_AUDIO_SINK@ 2> /dev/null | grep -q 'device.api = "bluez5"'; then
    echo " | vol $percent% bt"
else
    echo " | vol $percent%"
fi
